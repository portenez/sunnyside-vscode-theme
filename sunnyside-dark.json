{
  "name": "Sunnyside Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#24211D",
    "editor.foreground": "#D2C8B9",
    "editorLineNumber.foreground": "#938779",
    "editorLineNumber.activeForeground": "#C39A5D",
    "editorCursor.foreground": "#C39A5D",
    "editor.selectionBackground": "#4B4034",
    "editor.inactiveSelectionBackground": "#37312A",
    "editor.lineHighlightBackground": "#2D2923",
    "editorWhitespace.foreground": "#494137",
    "editorIndentGuide.background1": "#40392F",
    "editorIndentGuide.activeBackground1": "#7E6D56",
    "editor.findMatchBackground": "#77501D",
    "editor.findMatchHighlightBackground": "#604222",
    "editorBracketMatch.background": "#493721",
    "editorBracketMatch.border": "#C39A5D",
    "sideBar.background": "#211E1A",
    "sideBar.foreground": "#BFB5A6",
    "activityBar.background": "#1C1916",
    "activityBar.foreground": "#C39A5D",
    "activityBar.inactiveForeground": "#A09688",
    "activityBarBadge.background": "#C39A5D",
    "activityBarBadge.foreground": "#24211D",
    "statusBar.background": "#2B2721",
    "statusBar.foreground": "#D2C8B9",
    "statusBar.noFolderBackground": "#2B2721",
    "statusBar.debuggingBackground": "#614220",
    "titleBar.activeBackground": "#211E1A",
    "titleBar.activeForeground": "#D2C8B9",
    "titleBar.inactiveBackground": "#24211D",
    "tab.activeBackground": "#24211D",
    "tab.activeForeground": "#D2C8B9",
    "tab.inactiveBackground": "#2D2923",
    "tab.inactiveForeground": "#A09688",
    "tab.activeBorderTop": "#C39A5D",
    "editorGroupHeader.tabsBackground": "#211E1A",
    "panel.background": "#24211D",
    "panel.border": "#494137",
    "panelTitle.activeForeground": "#C39A5D",
    "input.background": "#272019",
    "input.foreground": "#D2C8B9",
    "input.border": "#65513A",
    "dropdown.background": "#272019",
    "dropdown.foreground": "#D2C8B9",
    "focusBorder": "#C39A5D",
    "button.background": "#A36A1F",
    "button.foreground": "#FFFFFF",
    "badge.background": "#A36A1F",
    "badge.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#493721",
    "list.activeSelectionForeground": "#D2C8B9",
    "list.hoverBackground": "#2D251C",
    "terminal.background": "#24211D",
    "terminal.foreground": "#D2C8B9",
    "terminalCursor.foreground": "#C39A5D",
    "terminal.ansiBlack": "#2D2923",
    "terminal.ansiBrightBlack": "#A09688",
    "terminal.ansiRed": "#CF886C",
    "terminal.ansiGreen": "#A5B58A",
    "terminal.ansiYellow": "#D8A044",
    "terminal.ansiBlue": "#92AFBA",
    "terminal.ansiMagenta": "#A59AB1",
    "terminal.ansiCyan": "#8BB8AA",
    "terminal.ansiWhite": "#BFB5A6",
    "terminal.ansiBrightRed": "#DA9A7F",
    "terminal.ansiBrightGreen": "#B6C59C",
    "terminal.ansiBrightYellow": "#E0B26C",
    "terminal.ansiBrightBlue": "#A5BFC8",
    "terminal.ansiBrightMagenta": "#B8ACC2",
    "terminal.ansiBrightCyan": "#A0C7BA",
    "terminal.ansiBrightWhite": "#D2C8B9"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#A09688",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D8A044",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#A5B58A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#CF886C",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#92AFBA",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#A59AB1",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BFAF98",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#C39A5D",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8BB8AA",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown heading fallback",
      "scope": [
        "markup.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#D8A044",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H1",
      "scope": [
        "heading.1.markdown",
        "heading.1.markdown entity.name.section.markdown",
        "heading.1.markdown punctuation.definition.heading.markdown",
        "markup.heading.setext.1.markdown",
        "markup.heading.setext.1.markdown entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#D8A044",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H2",
      "scope": [
        "heading.2.markdown",
        "heading.2.markdown entity.name.section.markdown",
        "heading.2.markdown punctuation.definition.heading.markdown",
        "markup.heading.setext.2.markdown",
        "markup.heading.setext.2.markdown entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#A59AB1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H3",
      "scope": [
        "heading.3.markdown",
        "heading.3.markdown entity.name.section.markdown",
        "heading.3.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#92AFBA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H4",
      "scope": [
        "heading.4.markdown",
        "heading.4.markdown entity.name.section.markdown",
        "heading.4.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#8BB8AA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H5",
      "scope": [
        "heading.5.markdown",
        "heading.5.markdown entity.name.section.markdown",
        "heading.5.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#A5B58A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H6",
      "scope": [
        "heading.6.markdown",
        "heading.6.markdown entity.name.section.markdown",
        "heading.6.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#CF886C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#D8A044",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic.markdown"
      ],
      "settings": {
        "foreground": "#A59AB1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": [
        "markup.bold.markdown markup.italic.markdown",
        "markup.italic.markdown markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#D8A044",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#A5B58A",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#92AFBA",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link destination",
      "scope": [
        "markup.underline.link.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#8BB8AA",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown quote marker",
      "scope": [
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#A09688",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown lists and dividers",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "meta.separator.markdown",
        "punctuation.separator.table.markdown"
      ],
      "settings": {
        "foreground": "#D8A044",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown code fence markers",
      "scope": [
        "fenced_code.block.language.markdown",
        "punctuation.definition.markdown"
      ],
      "settings": {
        "foreground": "#8BB8AA",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown deleted text",
      "scope": [
        "markup.strikethrough.markdown"
      ],
      "settings": {
        "foreground": "#A09688",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#92AFBA",
    "method": "#92AFBA",
    "class": "#A59AB1",
    "interface": "#A59AB1",
    "type": "#A59AB1",
    "parameter": "#BFAF98",
    "property": "#8BB8AA",
    "sunnysideTableHeader:markdown": {
      "foreground": "#D8A044",
      "bold": true
    }
  }
}
