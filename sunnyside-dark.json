{
  "name": "Sunnyside Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#14120F",
    "editor.foreground": "#F3EADB",
    "editorLineNumber.foreground": "#84796C",
    "editorLineNumber.activeForeground": "#E8A23A",
    "editorCursor.foreground": "#E8A23A",
    "editor.selectionBackground": "#59422C",
    "editor.inactiveSelectionBackground": "#393026",
    "editor.lineHighlightBackground": "#211D17",
    "editorWhitespace.foreground": "#493F32",
    "editorIndentGuide.background1": "#3A3228",
    "editorIndentGuide.activeBackground1": "#79644A",
    "editor.findMatchBackground": "#77501D",
    "editor.findMatchHighlightBackground": "#604222",
    "editorBracketMatch.background": "#493721",
    "editorBracketMatch.border": "#E8A23A",
    "sideBar.background": "#191611",
    "sideBar.foreground": "#DED2C0",
    "activityBar.background": "#0C0A08",
    "activityBar.foreground": "#E8A23A",
    "activityBar.inactiveForeground": "#B5AA99",
    "activityBarBadge.background": "#E8A23A",
    "activityBarBadge.foreground": "#14120F",
    "statusBar.background": "#2B2117",
    "statusBar.foreground": "#F3EADB",
    "statusBar.noFolderBackground": "#2B2117",
    "statusBar.debuggingBackground": "#614220",
    "titleBar.activeBackground": "#191611",
    "titleBar.activeForeground": "#F3EADB",
    "titleBar.inactiveBackground": "#14120F",
    "tab.activeBackground": "#14120F",
    "tab.activeForeground": "#F3EADB",
    "tab.inactiveBackground": "#211C16",
    "tab.inactiveForeground": "#B5AA99",
    "tab.activeBorderTop": "#E8A23A",
    "editorGroupHeader.tabsBackground": "#191611",
    "panel.background": "#14120F",
    "panel.border": "#493F32",
    "panelTitle.activeForeground": "#E8A23A",
    "input.background": "#272019",
    "input.foreground": "#F3EADB",
    "input.border": "#65513A",
    "dropdown.background": "#272019",
    "dropdown.foreground": "#F3EADB",
    "focusBorder": "#E8A23A",
    "button.background": "#A36A1F",
    "button.foreground": "#FFFFFF",
    "badge.background": "#A36A1F",
    "badge.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#493721",
    "list.activeSelectionForeground": "#F3EADB",
    "list.hoverBackground": "#2D251C",
    "terminal.background": "#14120F",
    "terminal.foreground": "#F3EADB",
    "terminalCursor.foreground": "#E8A23A",
    "terminal.ansiBlack": "#211D17",
    "terminal.ansiBrightBlack": "#B5AA99",
    "terminal.ansiRed": "#F08D83",
    "terminal.ansiGreen": "#B9CF8A",
    "terminal.ansiYellow": "#F1C06B",
    "terminal.ansiBlue": "#8FBFD0",
    "terminal.ansiMagenta": "#CFACE1",
    "terminal.ansiCyan": "#83CDBB",
    "terminal.ansiWhite": "#DED2C0",
    "terminal.ansiBrightRed": "#FFACA1",
    "terminal.ansiBrightGreen": "#D0E7A4",
    "terminal.ansiBrightYellow": "#FFDA94",
    "terminal.ansiBrightBlue": "#B0D9E6",
    "terminal.ansiBrightMagenta": "#E8C8F3",
    "terminal.ansiBrightCyan": "#A2E5D3",
    "terminal.ansiBrightWhite": "#F3EADB"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#B5AA99",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F1C06B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#B9CF8A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F08D83",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8FBFD0",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#CFACE1",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E5C6A0",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E8A23A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#83CDBB",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown heading fallback",
      "scope": [
        "markup.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#F1C06B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H1",
      "scope": [
        "heading.1.markdown",
        "heading.1.markdown entity.name.section.markdown",
        "heading.1.markdown punctuation.definition.heading.markdown",
        "markup.heading.setext.1.markdown",
        "markup.heading.setext.1.markdown entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#F1C06B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H2",
      "scope": [
        "heading.2.markdown",
        "heading.2.markdown entity.name.section.markdown",
        "heading.2.markdown punctuation.definition.heading.markdown",
        "markup.heading.setext.2.markdown",
        "markup.heading.setext.2.markdown entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#CFACE1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H3",
      "scope": [
        "heading.3.markdown",
        "heading.3.markdown entity.name.section.markdown",
        "heading.3.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#8FBFD0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H4",
      "scope": [
        "heading.4.markdown",
        "heading.4.markdown entity.name.section.markdown",
        "heading.4.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#83CDBB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H5",
      "scope": [
        "heading.5.markdown",
        "heading.5.markdown entity.name.section.markdown",
        "heading.5.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#B9CF8A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown H6",
      "scope": [
        "heading.6.markdown",
        "heading.6.markdown entity.name.section.markdown",
        "heading.6.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F08D83",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#F1C06B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic.markdown"
      ],
      "settings": {
        "foreground": "#CFACE1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": [
        "markup.bold.markdown markup.italic.markdown",
        "markup.italic.markdown markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#F1C06B",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#B9CF8A",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#8FBFD0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link destination",
      "scope": [
        "markup.underline.link.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#83CDBB",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown quote marker",
      "scope": [
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#B5AA99",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown lists and dividers",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "meta.separator.markdown",
        "punctuation.separator.table.markdown"
      ],
      "settings": {
        "foreground": "#F1C06B",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown code fence markers",
      "scope": [
        "fenced_code.block.language.markdown",
        "punctuation.definition.markdown"
      ],
      "settings": {
        "foreground": "#83CDBB",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown deleted text",
      "scope": [
        "markup.strikethrough.markdown"
      ],
      "settings": {
        "foreground": "#B5AA99",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#8FBFD0",
    "method": "#8FBFD0",
    "class": "#CFACE1",
    "interface": "#CFACE1",
    "type": "#CFACE1",
    "parameter": "#E5C6A0",
    "property": "#83CDBB",
    "sunnysideTableHeader.markdown": {
      "foreground": "#F1C06B",
      "bold": true
    }
  }
}
